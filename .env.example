# ------------------------------------------------------------------
# Plantilla de variables de entorno — COPIA este archivo como ".env"
# y rellena con tus valores reales. El archivo .env NUNCA se sube a Git.
# ------------------------------------------------------------------

# --- Se usan en el NAVEGADOR (frontend). Prefijo VITE_ obligatorio. ---
# Son públicas por diseño (protegidas por Row Level Security).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXX

# --- Se usan SOLO en el SERVIDOR (funciones /api en Vercel). ---
# NO llevan prefijo VITE_ (si lo llevaran, se filtrarian al navegador).
# SUPABASE_SERVICE_KEY es la llave 'service_role' — TODOPODEROSA, secreta.
# En local no hacen falta (las funciones /api solo corren en Vercel).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJXXXX.service_role.XXXX
